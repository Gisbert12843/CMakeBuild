    @staticmethod
    def _fetch_content_block(library: LibrarySpec) -> list[str]:
        """The FetchContent calls that clone a remote library at configure time.

        SOURCE_DIR keeps the checkout inside the build directory, under a folder
        named after the library, and FetchContent_MakeAvailable adds it as a
        subdirectory - the same thing a local library gets.
        """
        block = [
            "",
            f"FetchContent_Declare({library.name}",
            f"    GIT_REPOSITORY {library.url}",
        ]
        if library.ref:
            block.append(f"    GIT_TAG        {library.ref}")
        # A shallow clone can only resolve a named ref, never a raw commit hash.
        if not library.ref or not _COMMIT_SHA.match(library.ref):
            block.append("    GIT_SHALLOW    TRUE")
        block.append("    GIT_PROGRESS   TRUE")
        if library.subdir:
            # The CMakeLists.txt sits in a subfolder of the repository, so point
            # MakeAvailable at it instead of the (possibly project-less) root.
            block.append(f"    SOURCE_SUBDIR  {library.subdir}")
        block.extend(
            [
                f"    SOURCE_DIR     ${{CMAKE_BINARY_DIR}}/{Remote_Library_Subdir}/{library.name}",
                ")",
                f"FetchContent_MakeAvailable({library.name})",
            ]
        )
        return block

    def _handle_libraries(self, children: list[str]) -> bool:

        if not children:
            term.skipped("Ignoring empty 'Libraries' topic.")
            return False

        libraries = [parse_library_entry(child) for child in children]

        # Create complete target_link_libraries call
        content = ["target_link_libraries(${CMAKE_PROJECT_NAME}"]
        content.extend([f"    {library.name}" for library in libraries])

        self.tasks.append(
            Task(
                TaskType.REPLACE,
                "target_link_libraries(",
                content,
            )
        )

        remote_libraries = [library for library in libraries if library.is_remote]
        if remote_libraries:
            self.tasks.append(
                Task(
                    TaskType.INSERT_BELOW,
                    "# SUBDIRECTORY_MARKER",
                    ["include(FetchContent)"],
                )
            )

        # Local libraries become a plain add_subdirectory, e.g.
        # add_subdirectory(../software/SDK/Cpp ${CMAKE_BINARY_DIR}/software_sdk_cpp),
        # remote ones a FetchContent block that does the same after cloning.
        for library in libraries:
            self.tasks.append(
                Task(
                    TaskType.INSERT_BELOW,
                    "# SUBDIRECTORY_MARKER",
                    (
                        self._fetch_content_block(library)
                        if library.is_remote
                        else [
                            f"add_subdirectory({library.path} ${{CMAKE_BINARY_DIR}}/{os.path.basename(library.path)})"
                        ]
                    ),
                )
            )

        term.task(f"Link libraries: {', '.join(lib.name for lib in libraries)}")

        local_paths = [lib.path for lib in libraries if not lib.is_remote]
        if local_paths:
            term.task(f"Add subdirectories: {', '.join(local_paths)}")

        for library in remote_libraries:
            pinned = f" @ {library.ref}" if library.ref else " (default branch)"
            term.task(f"Fetch {library.url}{pinned} into {library.cmake_path}")

        if remote_libraries:
            term.info(
                f"Remote libraries are cloned into '{Remote_Library_Dir}/', so a "
                "clean build re-fetches them."
            )

        return True


    def _handle_globaldefines(self, children: list[str]) -> bool:
        if not children:
            term.skipped("Ignoring empty 'GlobalDefines' topic.")
            return False

        defines = []

        for child in children:
            parts = child.split(" ", 1)  # Split on first space only
            if len(parts) == 2:
                define_name, define_value = parts
                defines.append(f"{define_name}={define_value}")
            else:
                defines.append(f"{child}")

        # Create a single target_compile_definitions call with all defines
        content = [f"target_compile_definitions(${{CMAKE_PROJECT_NAME}} PRIVATE"] + [
            f"    {define}" for define in defines
        ]
        self.tasks.append(
            Task(
                TaskType.REPLACE,
                "target_compile_definitions(${CMAKE_PROJECT_NAME}",
                content,
            )
        )
        term.task(f"Add global defines: {', '.join(defines)}")
        return True

    def _handle_custom_sets(self, children: list[str]) -> bool:
        """
        Handle CustomSets topic - emits plain set() commands right above the
        project() call, so they are in effect for the whole project.

        Accepted child formats:
            VARIABLE value
            VARIABLE=value
            VARIABLE "value with spaces"
        """
        if not children:
            term.skipped("Ignoring empty 'CustomSets' topic.")
            return False

        set_commands = []

        for child in children:
            # Only split on '=' when it appears before the first space,
            # so 'MY_VAR a=b' keeps 'a=b' as the value.
            first_word = child.split(" ", 1)[0]
            if "=" in first_word:
                variable, value = child.split("=", 1)
            else:
                parts = child.split(" ", 1)
                variable, value = parts[0], parts[1] if len(parts) == 2 else ""

            variable = variable.strip()
            value = value.strip()

            if not variable or not value:
                raise ValueError(
                    f"Custom set definition '{child}' must be in format "
                    f"'VARIABLE value' or 'VARIABLE=value'."
                )

            set_commands.append(f"set({variable} {value})")

        content = ["# Custom set commands"] + set_commands + [""]
        self.tasks.append(
            Task(
                TaskType.INSERT_ABOVE,
                "project(${CMAKE_PROJECT_NAME})",
                content,
            )
        )
        term.task(f"Add custom set commands: {', '.join(set_commands)}")
        return True

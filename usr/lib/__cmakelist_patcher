### Terminal styling
# These helpers are shared with the `cmakebuild` front-end, which imports this
# file by path. They live here rather than in a module of their own so the
# package stays at exactly two installable scripts.
#
# Colors are disabled automatically when stdout is not a TTY, when NO_COLOR is
# set, or for TERM=dumb, so piped/redirected output stays clean. Override with
# CMAKEBUILD_COLOR=always|never|auto.

_mode = os.environ.get("CMAKEBUILD_COLOR", "auto").lower()

if _mode == "always":
    COLOR = True
elif _mode == "never":
    COLOR = False
else:
    COLOR = (
        sys.stdout.isatty()
        and os.environ.get("NO_COLOR") is None
        and os.environ.get("TERM", "") != "dumb"
    )

# Child processes inherit the decision, so a redirected `cmakebuild` run does
# not end up with a colored patcher writing into the same pipe.
os.environ["CMAKEBUILD_COLOR"] = "always" if COLOR else "never"

# The patcher runs as a child process, so our own output must not sit in a
# block buffer while the child writes straight to the same stream.
try:
    sys.stdout.reconfigure(line_buffering=True)
except (AttributeError, ValueError):  # pragma: no cover - very old/odd streams
    pass

_CODES = {
    "reset": "\033[0m",
    "bold": "\033[1m",
    "dim": "\033[2m",
    "red": "\033[91m",
    "green": "\033[92m",
    "yellow": "\033[93m",
    "blue": "\033[94m",
    "magenta": "\033[95m",
    "cyan": "\033[96m",
    "grey": "\033[90m",
}

_UNICODE = "utf" in (sys.stdout.encoding or "").lower()

_SYM_OK = "✔" if _UNICODE else "+"
_SYM_FAIL = "✘" if _UNICODE else "x"
_SYM_WARN = "⚠" if _UNICODE else "!"
_SYM_INFO = "ℹ" if _UNICODE else "i"
_SYM_STEP = "▶" if _UNICODE else ">"
_SYM_TASK = "•" if _UNICODE else "-"
_RULE = "─" if _UNICODE else "-"


def paint(text: str, *styles: str) -> str:
    """Wraps text in the given styles (no-op when colors are disabled)."""
    if not COLOR or not styles:
        return text
    prefix = "".join(_CODES[s] for s in styles if s in _CODES)
    return f"{prefix}{text}{_CODES['reset']}" if prefix else text


def header(text: str) -> None:
    """A section heading with a rule under it."""
    print()
    print(paint(text, "bold", "cyan"))
    print(paint(_RULE * max(len(text), 8), "dim", "cyan"))


def step(text: str) -> None:
    """An action that is about to happen."""
    print(f"{paint(_SYM_STEP, 'blue')} {paint(text, 'bold')}")


def ok(text: str) -> None:
    print(f"{paint(_SYM_OK, 'green')} {text}")


def fail(text: str) -> None:
    print(f"{paint(_SYM_FAIL, 'red')} {paint(text, 'red', 'bold')}", file=sys.stderr)


def warn(text: str) -> None:
    print(f"{paint(_SYM_WARN, 'yellow')} {paint(text, 'yellow')}")


def info(text: str) -> None:
    print(f"  {paint(_SYM_INFO, 'cyan')} {text}")


def task(text: str) -> None:
    """A queued patch task / bullet item."""
    print(f"  {paint(_SYM_TASK, 'magenta')} {text}")


def detail(text: str) -> None:
    """Secondary, de-emphasised output."""
    print(f"  {paint(text, 'dim')}")


def kv(key: str, value: str, indent: int = 2) -> None:
    """A key: value pair with the value highlighted."""
    print(f"{' ' * indent}{paint(key + ':', 'dim')} {paint(str(value), 'cyan')}")


def skipped(text: str) -> None:
    """Something intentionally not done."""
    print(f"{paint(_SYM_TASK, 'grey')} {paint(text, 'grey')}")


def banner_success(text: str) -> None:
    print()
    print(paint(f" {_SYM_OK} {text} ", "bold", "green"))


def banner_failure(text: str) -> None:
    print()
    print(paint(f" {_SYM_FAIL} {text} ", "bold", "red"), file=sys.stderr)


# Bundled as a namespace so both this script and cmakebuild can say `term.ok(...)`.
term = types.SimpleNamespace(

class TaskType(Enum):
    """Enumeration for the different types of patching operations."""

    REPLACE = auto()
    INSERT_BELOW = auto()
    INSERT_ABOVE = auto()
    INSERT_BELOW_LAST = auto()
    INSERT_ABOVE_PADDING = auto()


@dataclass
class Task:
    """Represents a single modification task for the CMakeLists.txt file."""

    task_type: TaskType
    target_line_start: str
    new_line_content: list[str]  # Can be one or more lines
    padding: int = field(default=0)  # Number of empty lines for padding tasks
    completed: bool = field(default=False, init=False)


### Library declarations
# A library is declared as either
#     LibName path/to/library                -> a folder inside the project
#     LibName <git-url> [ref] [key=value...] -> cloned by the generated CMakeLists
# A bare token after the URL is the ref (branch, tag or commit); the supported
# key=value options are ref= and subdir=, the latter naming the folder inside
# the repository that holds the CMakeLists.txt to add.
# Remote libraries are checked out inside the build directory so they never
# show up in the source tree. The folder is named after the library instead of
# using FetchContent's lowercased "<name>-src" default, which keeps the path
# predictable for the include paths written into c_cpp_properties.json.
Build_Dir = "build"
Remote_Library_Subdir = "_remote"
Remote_Library_Dir = f"{Build_Dir}/{Remote_Library_Subdir}"

# git@host:owner/repo.git - the scp-like syntax git accepts without a scheme.
_SCP_LIKE_URL = re.compile(r"^[\w.+-]+@[\w.-]+:")
_COMMIT_SHA = re.compile(r"^[0-9a-fA-F]{7,40}$")


@dataclass
class LibrarySpec:
    """A single entry of the 'Libraries' topic."""

    name: str
    path: str  # Where the sources live, relative to the project root.
    url: str | None = None  # Only set for remote libraries.
    ref: str | None = None  # Branch, tag or commit; remote libraries only.
    subdir: str | None = None  # Folder inside the repo holding its CMakeLists.

    @property
    def is_remote(self) -> bool:
        return self.url is not None

    @property
    def cmake_path(self) -> str:
        """The folder whose CMakeLists.txt gets added to the build."""
        return f"{self.path}/{self.subdir}" if self.subdir else self.path


def is_remote_library_url(candidate: str) -> bool:
    """True when the value looks like a git URL rather than a local path."""
    return (
        candidate.startswith(("http://", "https://", "ssh://", "git://", "git+ssh://"))
        or candidate.endswith(".git")
        or bool(_SCP_LIKE_URL.match(candidate))
    )


_REMOTE_FORMAT_HINT = (
    "'library_name <git-url> [branch|tag|commit] [ref=...] [subdir=...]'"
)


def parse_library_entry(entry: str) -> LibrarySpec:
    """Turns one 'Libraries' line into a LibrarySpec.

    Raises:
        ValueError: If the line is not a well-formed library declaration.
    """
    name, _, remainder = entry.partition(" ")
    remainder = remainder.strip()

    if not name or not remainder:
        raise ValueError(
            f"Library definition '{entry}' must be in format "
            f"'library_name path/to/library' or {_REMOTE_FORMAT_HINT}"
        )

    # Local paths may contain spaces, so only a git URL is split any further.
    tokens = remainder.split()
    if not is_remote_library_url(tokens[0]):
        return LibrarySpec(name=name, path=remainder)

    url, options = tokens[0], tokens[1:]
    ref = None
    subdir = None

    for option in options:
        key, sep, value = option.partition("=")
        if not sep:
            # A bare token is the ref, the shorthand for the common case.
            key, value = "ref", option
        elif not value:
            raise ValueError(
                f"Option '{option}' of library '{name}' is missing a value."
            )

        if key == "ref":
            if ref is not None:
                raise ValueError(f"Library '{name}' sets the ref more than once.")
            ref = value
        elif key == "subdir":
            if subdir is not None:
                raise ValueError(f"Library '{name}' sets the subdir more than once.")
            subdir = value.strip("/")
        else:
            raise ValueError(
                f"Unknown option '{key}' for library '{name}'. "
                f"Expected {_REMOTE_FORMAT_HINT}"
            )

    return LibrarySpec(
        name=name,
        path=f"{Remote_Library_Dir}/{name}",
        url=url,
        ref=ref,
        subdir=subdir,
    )
